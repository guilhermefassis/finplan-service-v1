generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/finplan_app/nextjs_space/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  name             String
  password         String
  paymentFrequency String?     @default("MONTHLY")
  paymentDetails   Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  creditCards      CreditCard[]

  @@map("users")
}

model CreditCard {
  id          String        @id @default(uuid())
  userId      String
  name        String
  brand       String
  closingDay  Int
  dueDay      Int
  creditLimit Float
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  invoices    Invoice[]

  @@map("credit_cards")
}

model Transaction {
  id                  String     @id @default(uuid())
  creditCardId        String
  invoiceId           String?
  groupId             String
  purchaseDate        DateTime
  description         String
  category            String
  amount              Float
  installments        Boolean    @default(false)
  totalInstallments   Int?       @default(1)
  currentInstallment  Int?       @default(1)
  totalPurchaseAmount Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  creditCard          CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  invoice             Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

model Invoice {
  id             String        @id @default(uuid())
  creditCardId   String
  referenceMonth Int
  closingDate    DateTime
  dueDate        DateTime
  totalAmount    Float         @default(0)
  status         String        @default("OPEN")
  paymentDate    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  creditCard     CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([creditCardId, referenceMonth])
  @@map("invoices")
}
